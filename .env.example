# ── Core ────────────────────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL="postgresql://warroom:warroom@localhost:5432/warroom?schema=public"
# Redis connection (BullMQ queues)
REDIS_URL="redis://localhost:6379"

# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
# Used to AES-256-GCM encrypt secrets stored in the database (IMAP password, LinkedIn cookie).
APP_ENCRYPTION_KEY=""

# Random string, >= 32 chars. Generate: openssl rand -hex 32
# Signs the session cookie.
SESSION_SECRET=""

# ── Login (single-user system) ──────────────────────────────────────────
# The account is created on first login with these credentials.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-please"

# ── Optional ────────────────────────────────────────────────────────────
# Timezone used for daily schedules (cron) and digests
TZ="Asia/Jerusalem"
# Base URL of the web app (used in WhatsApp digest links)
APP_URL="http://localhost:3000"
# Directory where the WhatsApp (Baileys) pairing state is persisted
WHATSAPP_AUTH_DIR="./whatsapp-auth"
